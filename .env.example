# Copy to .env.local and fill in. All values below are placeholders.

# Supabase (Dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional: not needed by the app (accounts are created through an RPC)
SUPABASE_SERVICE_ROLE_KEY=

# Optional: qualitative AI analysis and voice interpretation (server only)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash-lite
OPENROUTER_FALLBACK_MODEL=
OPENROUTER_VOICE_MODEL=

# Optional: stats from other leagues (API-Football, free plan: 100 calls/day)
APIFOOTBALL_KEY=
APIFOOTBALL_MODE=direct

# Only for the check:* scripts that touch the database or call the app
TEST_EMAIL=ci-runner@fantasta.local
TEST_PASSWORD=
BASE_URL=http://localhost:3000
